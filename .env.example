PORT=4173
SENTINEL_X_HOST=127.0.0.1
SENTINEL_X_ALLOW_NETWORK=0
SENTINEL_X_RETENTION_DAYS=365
SENTINEL_X_RATE_LIMIT=120
SENTINEL_X_RATE_WINDOW_MS=60000
SENTINEL_X_REQUEST_TIMEOUT_MS=15000
SENTINEL_X_HEADERS_TIMEOUT_MS=16000
SENTINEL_X_KEEPALIVE_TIMEOUT_MS=5000
SENTINEL_X_MAX_REQUESTS_PER_SOCKET=1000
SENTINEL_X_REQUEST_LOG=0
SENTINEL_X_DB_PATH=./data/sentinel-x.db
# Use proxy mode only behind a trusted reverse proxy that strips client-supplied
# X-Sentinel-* headers and injects verified identity headers itself.
SENTINEL_X_AUTH_MODE=demo
SENTINEL_X_PROXY_SECRET=replace-with-a-long-random-secret
# Optional OpenAI-compatible grounded investigation endpoint. If absent or
# unhealthy, the evidence-only deterministic assistant remains active.
SENTINEL_X_LLM_ENDPOINT=
SENTINEL_X_LLM_MODEL=
SENTINEL_X_LLM_API_KEY=
SENTINEL_X_LLM_TIMEOUT_MS=8000

# Native Gemini (model ID is selected by the operator; no key reaches the browser).
SENTINEL_X_GEMINI_API_KEY=
SENTINEL_X_GEMINI_MODEL=
# Optional base URL for an explicitly trusted gateway. Default: Google API.
SENTINEL_X_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Real push telemetry. Generate a random token of at least 32 characters.
# POST /api/v1/telemetry/events with Authorization: Bearer <token>.
SENTINEL_X_TELEMETRY_TOKEN=

# Wazuh indexer account with read-only access to the configured alert index.
SENTINEL_X_WAZUH_URL=
SENTINEL_X_WAZUH_USER=
SENTINEL_X_WAZUH_PASSWORD=
SENTINEL_X_WAZUH_INDEX=wazuh-alerts-*
# 0 disables automatic polling; otherwise minimum 10000 milliseconds.
SENTINEL_X_WAZUH_POLL_MS=0
# Automatic bounded external investigation following a real-source detection.
SENTINEL_X_EXTERNAL_INVESTIGATIONS=0

# Explicitly provisioned organizations; default is always included.
SENTINEL_X_TENANTS=default
# Local sign-in: set AUTH_MODE=local and provision users with scripts/create-user.js.
# Secure cookies must be enabled behind HTTPS. Set the public origin for CSRF checks.
SENTINEL_X_SECURE_COOKIES=0
SENTINEL_X_PUBLIC_ORIGIN=http://127.0.0.1:4173
# Optional direct TLS instead of termination at a trusted reverse proxy.
SENTINEL_X_TLS_CERT=
SENTINEL_X_TLS_KEY=
